# AhmedBuilds.com Environment Variables Template
# Copy this file to .env.local and fill in your values

# Supabase Public Configuration (Safe for client exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret (Never expose to client or commit to git)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin & Site Configuration
ADMIN_EMAIL=ahmed@ahmedbuilds.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=true
